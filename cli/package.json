{
  "name": "tabcrew",
  "version": "0.6.2",
  "description": "TabCrew: give your AI agents their own isolated tabs in your real browser. Installs the local daemon, pairing host and MCP entries.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "tabcrew": "dist/cli.mjs"
  },
  "files": [
    "dist/cli.mjs",
    "dist/daemon.mjs",
    "dist/pair-host.mjs",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huynle/tabcrew.git",
    "directory": "cli"
  },
  "homepage": "https://github.com/huynle/tabcrew#readme",
  "bugs": {
    "url": "https://github.com/huynle/tabcrew/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "browser-automation",
    "ai-agents",
    "opencode",
    "claude-code"
  ],
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "node --check build.mjs",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "esbuild": "^0.28.0",
    "vitest": "^4.1.0"
  }
}
